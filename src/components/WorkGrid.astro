---
// Grid of before/after photos. Tapping one opens the lightbox
// (add <Lightbox /> once on any page that uses this).
import { img, srcset } from '../data/site.js';
const { photos } = Astro.props;
---
<ul class="work-grid">
  {photos.map((p) => (
    <li>
      <button
        type="button"
        class="work-item"
        data-lightbox-open
        data-big={img(p.file, 1800)}
        data-title={p.title}
        data-cap={p.cap}
        aria-label={`View larger: ${p.title} ${p.cap}`}
      >
        <img
          src={img(p.file, 800)}
          srcset={srcset(p.file, [500, 800, 1200])}
          sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 360px"
          alt={p.cap}
          loading="lazy"
          decoding="async"
        />
        <span class="work-cap"><strong>{p.title}</strong> {p.cap}</span>
      </button>
    </li>
  ))}
</ul>
