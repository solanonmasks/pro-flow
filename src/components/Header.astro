---
import { business, logo, nav, telHref } from '../data/site.js';
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <img src={logo} alt="" width="56" height="56" />
      <span class="brand-text">
        <span class="brand-name">PRO FLO</span>
        <span class="brand-sub">Drainage &amp; Landscape</span>
      </span>
    </a>
    <nav class="main-nav" aria-label="Main">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="header-phone" href={telHref}>
      <span class="header-phone-label">Call or text</span>
      <span class="header-phone-number">{business.phoneDisplay}</span>
    </a>
    <a class="btn btn-blue header-cta" href="/#quote">Free estimate</a>
    <a class="header-phone-mobile" href={telHref} aria-label={`Call ${business.phoneDisplay}`}>{business.phoneDisplay}</a>
  </div>
</header>
